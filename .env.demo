# Build mode for the GitHub Pages demo deployment.
# NODE_ENV is intentionally NOT set here: Vite derives it from the mode and
# rejects an explicit NODE_ENV in .env. `vite build --mode demo` already runs a
# production build (minify, tree-shake) for any non-development mode.
#
# VITE_APP_BASE_API=/dev-api matches the URL prefix used by mock/index.js
#   (mocks register routes as RegExp(`${VITE_APP_BASE_API}${url}`), so the
#    front-end XHR mock only intercepts when baseURL equals /dev-api).
# VITE_APP_USE_FRONTEND_MOCK enables the XHR hijack mock in src/main.ts.
VITE_APP_BASE_API = '/dev-api'
VITE_APP_USE_FRONTEND_MOCK = 'true'
