    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "md-editor-v3": "^6.5.3",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^6.2.2",
    "pinia": "^2.1.7",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.7",
    "splitpanes": "^4.1.2",
    "vue": "^3.4.0",
