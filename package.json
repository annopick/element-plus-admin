{
  "name": "vue-element-admin",
  "version": "5.0.0",
  "description": "A magical vue admin. Vue3 + TypeScript + Element Plus.",
  "author": "Pan <panfree23@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:stage": "vue-tsc --noEmit && vite build --mode staging",
