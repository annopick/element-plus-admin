    "@types/js-cookie": "^3.0.6",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.12.0",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.5",
